# WEEX API Configuration
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_API_PASSPHRASE=your_passphrase_here
WEEX_BASE_URL=https://api.weex.com

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/alphagenesis
REDIS_URL=redis://localhost:6379/0

# Model Configuration
MODEL_CHECKPOINT_DIR=./models/saved
MODEL_DEVICE=cuda  # cuda or cpu

# Risk Management
MAX_POSITION_SIZE=0.1  # Maximum position size as fraction of portfolio
MAX_LEVERAGE=3
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.05

# Backtesting
INITIAL_CAPITAL=100000
COMMISSION_RATE=0.001
SLIPPAGE_RATE=0.0005

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/alphagenesis.log

# Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true

# SDM Probe / Stealth / Champion Ladder
PROBE_MODE_ENABLED=true
PROBE_ENTRY_REASON=LOW_VOL_EXTREME_OVERRIDE
PROBE_OVERRIDE_ALLOWLIST=cmt_solusdt,cmt_xrpusdt
PROBE_SIZE_MULTIPLIER=0.25

# New-entry gross exposure cap / profit lock
MAX_GROSS_EXPOSURE_PCT=0.30
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_TRIGGER_PNL_PCT=0.0025
PROFIT_LOCK_GROSS_EXPOSURE_PCT=0.20

STEALTH_MODE_ENABLED=true
STEALTH_TIME_JITTER_MS_MAX=450
STEALTH_SIZE_JITTER_PCT=0.06
STEALTH_CHAMPION_EXTRA_SIZE_JITTER_PCT=0.02
STEALTH_SEED_SALT=weex-finals
STEALTH_BUCKET_SECONDS=900
STEALTH_MIN_SIZE_SCALE=0.05
STEALTH_MAX_SIZE_SCALE=2.00

CHAMPION_LADDER_ENABLED=true
CHAMPION_LADDER_STATE_PATH=/opt/AlphaGenesis/tmp/champion_ladder.json
CHAMPION_LADDER_LOOKBACK_HOURS=48
CHAMPION_LADDER_DEGRADE_HOURS=12
CHAMPION_LADDER_QUARANTINE_SECONDS=7200
CHAMPION_LADDER_MIN_TRADES=8
CHAMPION_LADDER_MIN_REVALIDATE_TRADES=4
CHAMPION_LADDER_SOFT_KILL_MIN_TRADES=5
CHAMPION_LADDER_MIN_WIN_RATE=0.55
CHAMPION_LADDER_MIN_PROFIT_FACTOR=1.60
CHAMPION_LADDER_MIN_NET_PNL=0.0
CHAMPION_LADDER_DEGRADE_WIN_RATE=0.45
CHAMPION_LADDER_DEGRADE_PROFIT_FACTOR=1.0
CHAMPION_LADDER_DEGRADE_NET_PNL=0.0
CHAMPION_LADDER_MIN_ABS_PNL=0.001

# Finals adaptation (non-blocking jitter + non-stationary tuple smoothing)
FINALS_JITTER_ENABLED=false
FINALS_JITTER_MAX_DELAY_S=6.0
FINALS_SIZE_JITTER_PCT=0.04
FINALS_TRIGGER_EPSILON_BPS=8
FINALS_JITTER_STALE_SECONDS=45
TUPLE_DECAY_ENABLED=true
TUPLE_DECAY_LAMBDA=0.95
