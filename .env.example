# =============================================================================
# AlphaGenesis WEEX Trading System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
#
# On the VM (weex-hackathon-vm):
#   sudo nano /opt/AlphaGenesis/.env
# =============================================================================

# -----------------------------------------------------------------------------
# WEEX API Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Get these from your WEEX account API management page
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_API_PASSPHRASE=your_passphrase_here

# API endpoint (production by default)
WEEX_BASE_URL=https://api.weex.com

# Set to "true" for testnet, "false" for production
WEEX_TESTNET=false

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
MODEL_CHECKPOINT_DIR=./models/saved
MODEL_DEVICE=cuda  # Use "cuda" if GPU available, otherwise "cpu"

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# -----------------------------------------------------------------------------
# Feature Flags (optional)
# -----------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true
