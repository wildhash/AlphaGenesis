# WEEX API Configuration
WEEX_API_KEY=your_api_key_here
WEEX_API_SECRET=your_api_secret_here
WEEX_API_PASSPHRASE=your_passphrase_here
WEEX_BASE_URL=https://api.weex.com

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/alphagenesis
REDIS_URL=redis://localhost:6379/0

# Model Configuration
MODEL_CHECKPOINT_DIR=./models/saved
MODEL_DEVICE=cuda  # cuda or cpu

# Risk Management
MAX_POSITION_SIZE=0.1  # Maximum position size as fraction of portfolio
MAX_LEVERAGE=3
STOP_LOSS_PERCENT=0.02
TAKE_PROFIT_PERCENT=0.05

# Backtesting
INITIAL_CAPITAL=100000
COMMISSION_RATE=0.001
SLIPPAGE_RATE=0.0005

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/alphagenesis.log

# Feature Flags
ENABLE_LIVE_TRADING=false
ENABLE_PAPER_TRADING=true
ENABLE_BACKTESTING=true
