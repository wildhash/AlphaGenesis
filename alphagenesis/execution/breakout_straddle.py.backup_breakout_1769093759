"""
Breakout Straddle Manager for WEEX hedge mode.

Opens simultaneous LONG + SHORT, then closes the losing leg on breakout
and trails the winner with a software stop.
"""

import time
from typing import Dict, List, Tuple

import numpy as np

from loguru import logger


class BreakoutStraddleManager:
    STATE_IDLE = "IDLE"
    STATE_HEDGED = "HEDGED"
    STATE_RUNNER_LONG = "RUNNER_LONG"
    STATE_RUNNER_SHORT = "RUNNER_SHORT"
    STATE_DONE = "DONE"
    STATE_COOLDOWN = "COOLDOWN"

    def __init__(
        self,
        weex_client,
        position_ledger=None,
        straddle_risk: float = 0.18,
        breakout_pct: float = 0.016,
        trail_activation_pct: float = 0.01,
        trail_pct: float = 0.006,
        initial_stop_loss_pct: float = 0.01,
        max_hold_seconds: int = 7200,
        max_margin_usage_pct: float = 0.8,
        cooldown_seconds: int = 45,
        min_action_interval: float = 3.0,
        min_update_interval: float = 1.0,
        max_position_pct: float = 0.25,
        normal_atr_pct: float = 0.003,
        dry_run: bool = False,
    ):
        self.weex = weex_client
        self.position_ledger = position_ledger
        self.straddle_risk = straddle_risk
        self.breakout_pct = breakout_pct
        self.trail_activation_pct = trail_activation_pct
        self.trail_pct = trail_pct
        self.initial_stop_loss_pct = initial_stop_loss_pct
        self.max_hold_seconds = max_hold_seconds
        self.max_margin_usage_pct = max_margin_usage_pct
        self.cooldown_seconds = cooldown_seconds
        self.min_action_interval = min_action_interval
        self.min_update_interval = min_update_interval
        self.max_position_pct = max_position_pct
        self.normal_atr_pct = normal_atr_pct
        self.dry_run = dry_run
        self.position_size_multiplier = 1.0
        self.last_daily_pnl = 0.0
        self.gamma_mode = False
        self.gamma_params = {
            "breakout_threshold": 0.025,
            "initial_stop_loss": 0.015,
            "trail_activation": 0.008,
            "trail_distance": 0.015,
            "time_stop_seconds": 1800,
            "position_size_multiplier": 1.5,
        }

        self._states: Dict[str, Dict] = {}

    def _get_state(self, symbol: str) -> Dict:
        return self._states.setdefault(symbol, {
            "state": self.STATE_IDLE,
            "entry_price": 0.0,
            "entry_time": 0.0,
            "size": 0.0,
            "breakout_pct": self.breakout_pct,
            "initial_stop_loss_pct": self.initial_stop_loss_pct,
            "trail_activation_pct": self.trail_activation_pct,
            "trail_pct": self.trail_pct,
            "max_hold_seconds": self.max_hold_seconds,
            "atr_ratio": 1.0,
            "realized_pnl": 0.0,
            "pnl_applied": False,
            "peak_price": 0.0,
            "trough_price": 0.0,
            "runner_start_time": 0.0,
            "last_action_ts": 0.0,
            "last_update_ts": 0.0,
            "last_price": 0.0,
            "cooldown_until": 0.0,
        })

    def _reset_if_ready(self, state: Dict, now: float):
        if state["state"] == self.STATE_DONE:
            state["state"] = self.STATE_IDLE
        if state["state"] == self.STATE_COOLDOWN and now >= state["cooldown_until"]:
            logger.info("🟢 STRADDLE COOLDOWN CLEARED")
            state["state"] = self.STATE_IDLE

    def _can_act(self, state: Dict, now: float) -> bool:
        return (now - state["last_action_ts"]) >= self.min_action_interval

    def _mark_action(self, state: Dict, now: float):
        state["last_action_ts"] = now

    def _order_success(self, result: Dict) -> bool:
        if not isinstance(result, dict):
            return False
        if result.get("dry_run"):
            return True
        if "order_id" in result or "client_oid" in result:
            return True
        data = result.get("data")
        if isinstance(data, dict) and ("orderId" in data or "order_id" in data):
            return True
        return False

    def _is_40015(self, result: Dict) -> bool:
        if not isinstance(result, dict):
            return False
        for key in ("code", "status_code", "error", "msg", "message"):
            value = result.get(key)
            if value is not None and "40015" in str(value):
                return True
        return False

    def _place_order(self, symbol: str, side: int, size: float) -> Dict:
        if self.dry_run:
            logger.info(f"🟡 DRY_RUN: Would place order side={side} size={size:.6f} {symbol}")
            return {"dry_run": True, "client_oid": f"dry_run_{symbol}_{int(time.time())}"}
        return self.weex.place_order(symbol=symbol, side=side, size=size, is_market=True)

    def _enter_cooldown(self, state: Dict, reason: str):
        state["state"] = self.STATE_COOLDOWN
        state["cooldown_until"] = time.time() + self.cooldown_seconds
        logger.warning(f"⚠ STRADDLE ABORTED ({reason})")

    def _close_long(self, symbol: str, size: float, state: Dict) -> bool:
        result = self._place_order(symbol, side=3, size=size)
        if self._is_40015(result):
            self._enter_cooldown(state, "40015")
            return False
        return self._order_success(result)

    def _close_short(self, symbol: str, size: float, state: Dict) -> bool:
        result = self._place_order(symbol, side=4, size=size)
        if self._is_40015(result):
            self._enter_cooldown(state, "40015")
            return False
        return self._order_success(result)

    def is_blocked(self, symbol: str) -> bool:
        state = self._get_state(symbol)
        blocked = state["state"] in {
            self.STATE_HEDGED,
            self.STATE_RUNNER_LONG,
            self.STATE_RUNNER_SHORT,
            self.STATE_COOLDOWN,
        }
        if blocked:
            logger.info(
                "DIAG_STRADDLE_BLOCK symbol={} state={} cooldown_until={}",
                symbol,
                state.get("state"),
                state.get("cooldown_until")
            )
        return blocked

    def active_symbols(self) -> set:
        return {
            symbol for symbol, state in self._states.items()
            if state["state"] in {
                self.STATE_HEDGED,
                self.STATE_RUNNER_LONG,
                self.STATE_RUNNER_SHORT,
                self.STATE_COOLDOWN,
            }
        }

    def set_daily_pnl(self, daily_pnl: float):
        self.last_daily_pnl = daily_pnl
        if daily_pnl >= 0.05 and self.position_size_multiplier != 1.0:
            self.position_size_multiplier = 1.0
            logger.info("🎯 DAILY TARGET HIT 5% → Resetting to base size")

    def set_gamma_mode(self, enabled: bool, params: Dict | None = None):
        if params:
            self.gamma_params.update(params)
        if enabled != self.gamma_mode:
            self.gamma_mode = enabled
            state = "ON" if enabled else "OFF"
            logger.warning(f"⚠ VOLATILITY REGIME CHANGED: gamma_squeeze {state}")

    def _extract_candle_arrays(self, candles: List) -> Tuple[List[float], List[float], List[float]]:
        highs = []
        lows = []
        closes = []
        for c in candles:
            if isinstance(c, dict):
                highs.append(float(c.get("high", 0)))
                lows.append(float(c.get("low", 0)))
                closes.append(float(c.get("close", 0)))
            elif isinstance(c, list) and len(c) >= 5:
                highs.append(float(c[2]))
                lows.append(float(c[3]))
                closes.append(float(c[4]))
        return highs, lows, closes

    def _atr_ratio(self, symbol: str, price: float) -> float:
        try:
            candles = self.weex.get_candles(symbol=symbol, interval="1m", limit=21)
        except Exception as exc:
            logger.warning(f"ATR fetch failed for {symbol}: {exc}")
            return 1.0

        if isinstance(candles, dict) and "data" in candles:
            data = candles["data"]
        else:
            data = candles

        if not isinstance(data, list) or len(data) < 20:
            return 1.0

        highs, lows, closes = self._extract_candle_arrays(data[-20:])
        if len(highs) < 20 or len(lows) < 20 or len(closes) < 20:
            return 1.0

        prev_close = np.array(closes[:-1])
        curr_high = np.array(highs[1:])
        curr_low = np.array(lows[1:])
        tr = np.maximum(
            curr_high - curr_low,
            np.maximum(np.abs(curr_high - prev_close), np.abs(curr_low - prev_close))
        )
        atr = float(np.mean(tr)) if len(tr) else 0.0
        if price <= 0 or atr <= 0:
            return 1.0

        atr_pct = atr / price
        if self.normal_atr_pct <= 0:
            return 1.0
        return atr_pct / self.normal_atr_pct

    def get_atr_ratio(self, symbol: str, price: float) -> float:
        """Public ATR ratio helper for logging/debugging."""
        return self._atr_ratio(symbol, price)

    def _scaled_thresholds(self, atr_ratio: float) -> Tuple[float, float, float, float, int, float]:
        if self.gamma_mode:
            breakout = self.gamma_params["breakout_threshold"]
            initial_stop = self.gamma_params["initial_stop_loss"]
            trail_activation = self.gamma_params["trail_activation"]
            size_multiplier = self.gamma_params["position_size_multiplier"]
            max_hold = self.gamma_params["time_stop_seconds"]
            trail_pct = self.gamma_params["trail_distance"]
            return breakout, initial_stop, trail_activation, size_multiplier, max_hold, trail_pct

        if atr_ratio < 0.5:
            scale = 0.4
            size_multiplier = 1.8
            trail_ratio = 0.3
            max_hold = 30 * 60
        elif atr_ratio < 0.8:
            scale = 0.6
            size_multiplier = 1.5
            trail_ratio = 0.4
            max_hold = 60 * 60
        elif atr_ratio > 1.5:
            scale = 1.3
            size_multiplier = 0.8
            trail_ratio = 0.8
            max_hold = 3 * 60 * 60
        elif atr_ratio > 1.2:
            scale = 1.1
            size_multiplier = 1.2
            trail_ratio = 0.7
            max_hold = int(2.5 * 60 * 60)
        else:
            scale = 1.0
            size_multiplier = 1.0
            trail_ratio = 0.6
            max_hold = self.max_hold_seconds

        breakout = self.breakout_pct * scale
        initial_stop = self.initial_stop_loss_pct * scale
        trail_activation = breakout * trail_ratio
        trail_pct = self.trail_pct

        breakout = max(0.008, min(0.025, breakout))
        initial_stop = max(0.006, min(0.015, initial_stop))

        return breakout, initial_stop, trail_activation, size_multiplier, max_hold, trail_pct

    def _calculate_size(self, symbol: str, legacy_amount: float, price: float) -> Tuple[float, float, float, float, int, float]:
        atr_ratio = self._atr_ratio(symbol, price)
        breakout, initial_stop, trail_activation, size_multiplier, max_hold, trail_pct = self._scaled_thresholds(atr_ratio)

        size_pct = self.straddle_risk * size_multiplier * self.position_size_multiplier
        size_pct = min(size_pct, self.max_position_pct)
        notional = legacy_amount * size_pct
        return notional / price, atr_ratio, breakout, initial_stop, trail_activation, max_hold, trail_pct

    def try_open(self, symbol: str, price: float, legacy_amount: float) -> bool:
        now = time.time()
        state = self._get_state(symbol)
        self._reset_if_ready(state, now)

        if state["state"] != self.STATE_IDLE:
            return False

        if price <= 0 or legacy_amount <= 0:
            return False

        if self.position_ledger:
            ledger_pos = self.position_ledger.get_position(symbol)
            if ledger_pos.side != "FLAT":
                logger.warning(f"⚠ STRADDLE SKIPPED - existing ledger position {ledger_pos.side} on {symbol}")
                return False

        size, atr_ratio, breakout, initial_stop, trail_activation, max_hold, trail_pct = self._calculate_size(
            symbol,
            legacy_amount,
            price
        )
        if size <= 0:
            return False
        estimated_usage = size * price * 2.0
        if estimated_usage > (legacy_amount * self.max_margin_usage_pct):
            logger.warning("⚠ STRADDLE ABORTED (INSUFFICIENT MARGIN)")
            return False

        long_result = self._place_order(symbol, side=1, size=size)
        short_result = self._place_order(symbol, side=2, size=size)

        long_ok = self._order_success(long_result)
        short_ok = self._order_success(short_result)

        if self._is_40015(long_result) or self._is_40015(short_result):
            if long_ok:
                self._close_long(symbol, size, state)
            if short_ok:
                self._close_short(symbol, size, state)
            self._enter_cooldown(state, "40015")
            return False

        if not long_ok or not short_ok:
            if long_ok:
                self._close_long(symbol, size, state)
            if short_ok:
                self._close_short(symbol, size, state)
            logger.warning("⚠ STRADDLE OPEN FAILED (partial fill cleaned up)")
            return False

        state["state"] = self.STATE_HEDGED
        state["entry_price"] = price
        state["entry_time"] = now
        state["size"] = size
        state["breakout_pct"] = breakout
        state["initial_stop_loss_pct"] = initial_stop
        state["trail_activation_pct"] = trail_activation
        state["trail_pct"] = trail_pct
        state["max_hold_seconds"] = max_hold
        state["atr_ratio"] = atr_ratio
        state["realized_pnl"] = 0.0
        state["pnl_applied"] = False
        state["peak_price"] = price
        state["trough_price"] = price
        state["runner_start_time"] = 0.0
        state["last_price"] = price
        logger.info(
            f"🟡 STRADDLE OPENED size={size:.6f} atr_ratio={atr_ratio:.2f} "
            f"breakout={breakout*100:.2f}% initial_stop={initial_stop*100:.2f}% "
            f"trail_activation={trail_activation*100:.2f}% trail_distance={trail_pct*100:.2f}% "
            f"max_hold={max_hold}s gamma_mode={self.gamma_mode}"
        )
        return True

    def update(self, symbol: str, price: float):
        now = time.time()
        state = self._get_state(symbol)
        self._reset_if_ready(state, now)

        if price <= 0:
            return

        if (now - state["last_update_ts"]) < self.min_update_interval:
            return

        state["last_update_ts"] = now
        state["last_price"] = price

        current_state = state["state"]
        if current_state in {self.STATE_IDLE, self.STATE_DONE}:
            return
        if current_state == self.STATE_COOLDOWN:
            return

        if current_state == self.STATE_HEDGED:
            elapsed = now - state["entry_time"]
            if elapsed >= state["max_hold_seconds"]:
                logger.info("⏱ TIME STOP EXIT (no breakout)")
                if self._can_act(state, now):
                    state["realized_pnl"] += (price - state["entry_price"]) * state["size"]
                    state["realized_pnl"] += (state["entry_price"] - price) * state["size"]
                    self._close_long(symbol, state["size"], state)
                    self._close_short(symbol, state["size"], state)
                    self._mark_action(state, now)
                    state["state"] = self.STATE_DONE
                    self._maybe_apply_compound(state)
                return

            if price >= state["entry_price"] * (1 + state["initial_stop_loss_pct"]):
                logger.info("🧯 INITIAL STOP LOSS → closing SHORT")
                if self._can_act(state, now):
                    state["realized_pnl"] += (state["entry_price"] - price) * state["size"]
                    if self._close_short(symbol, state["size"], state):
                        state["state"] = self.STATE_RUNNER_LONG
                        state["runner_start_time"] = now
                        state["peak_price"] = price
                        logger.info("🏃 RUNNER ACTIVE (LONG)")
                    self._mark_action(state, now)
                return

            if price <= state["entry_price"] * (1 - state["initial_stop_loss_pct"]):
                logger.info("🧯 INITIAL STOP LOSS → closing LONG")
                if self._can_act(state, now):
                    state["realized_pnl"] += (price - state["entry_price"]) * state["size"]
                    if self._close_long(symbol, state["size"], state):
                        state["state"] = self.STATE_RUNNER_SHORT
                        state["runner_start_time"] = now
                        state["trough_price"] = price
                        logger.info("🏃 RUNNER ACTIVE (SHORT)")
                    self._mark_action(state, now)
                return

            if price >= state["entry_price"] * (1 + state["breakout_pct"]):
                logger.info("🚀 BREAKOUT UP → closing SHORT")
                if self._can_act(state, now):
                    state["realized_pnl"] += (state["entry_price"] - price) * state["size"]
                    if self._close_short(symbol, state["size"], state):
                        state["state"] = self.STATE_RUNNER_LONG
                        state["runner_start_time"] = now
                        state["peak_price"] = price
                        logger.info("🏃 RUNNER ACTIVE (LONG)")
                    self._mark_action(state, now)
                return

            if price <= state["entry_price"] * (1 - state["breakout_pct"]):
                logger.info("📉 BREAKOUT DOWN → closing LONG")
                if self._can_act(state, now):
                    state["realized_pnl"] += (price - state["entry_price"]) * state["size"]
                    if self._close_long(symbol, state["size"], state):
                        state["state"] = self.STATE_RUNNER_SHORT
                        state["runner_start_time"] = now
                        state["trough_price"] = price
                        logger.info("🏃 RUNNER ACTIVE (SHORT)")
                    self._mark_action(state, now)
                return

        if current_state == self.STATE_RUNNER_LONG:
            state["peak_price"] = max(state["peak_price"], price)
            trail_armed = price >= state["entry_price"] * (1 + state["trail_activation_pct"])

            if now - state["runner_start_time"] >= state["max_hold_seconds"]:
                logger.info("⏱ TIME STOP EXIT")
                if self._can_act(state, now):
                    state["realized_pnl"] += (price - state["entry_price"]) * state["size"]
                    if self._close_long(symbol, state["size"], state):
                        state["state"] = self.STATE_DONE
                        self._maybe_apply_compound(state)
                    self._mark_action(state, now)
                return

            if trail_armed and price <= state["peak_price"] * (1 - state["trail_pct"]):
                logger.info("🛑 TRAILING STOP HIT")
                if self._can_act(state, now):
                    state["realized_pnl"] += (price - state["entry_price"]) * state["size"]
                    if self._close_long(symbol, state["size"], state):
                        state["state"] = self.STATE_DONE
                        self._maybe_apply_compound(state)
                    self._mark_action(state, now)
                return

        if current_state == self.STATE_RUNNER_SHORT:
            state["trough_price"] = min(state["trough_price"], price)
            trail_armed = price <= state["entry_price"] * (1 - state["trail_activation_pct"])

            if now - state["runner_start_time"] >= state["max_hold_seconds"]:
                logger.info("⏱ TIME STOP EXIT")
                if self._can_act(state, now):
                    state["realized_pnl"] += (state["entry_price"] - price) * state["size"]
                    if self._close_short(symbol, state["size"], state):
                        state["state"] = self.STATE_DONE
                        self._maybe_apply_compound(state)
                    self._mark_action(state, now)
                return

            if trail_armed and price >= state["trough_price"] * (1 + state["trail_pct"]):
                logger.info("🛑 TRAILING STOP HIT")
                if self._can_act(state, now):
                    state["realized_pnl"] += (state["entry_price"] - price) * state["size"]
                    if self._close_short(symbol, state["size"], state):
                        state["state"] = self.STATE_DONE
                        self._maybe_apply_compound(state)
                    self._mark_action(state, now)
                return

    def force_close(self, symbol: str):
        state = self._get_state(symbol)
        if state["state"] in {self.STATE_IDLE, self.STATE_DONE}:
            return

        logger.warning("🛑 STRADDLE FORCE CLOSE")
        price = state["last_price"]
        if price > 0:
            state["realized_pnl"] += (price - state["entry_price"]) * state["size"]
            state["realized_pnl"] += (state["entry_price"] - price) * state["size"]
        self._close_long(symbol, state["size"], state)
        self._close_short(symbol, state["size"], state)
        state["state"] = self.STATE_DONE
        self._maybe_apply_compound(state)

    def _maybe_apply_compound(self, state: Dict):
        if state.get("pnl_applied"):
            return
        pnl = state.get("realized_pnl", 0.0)
        if pnl > 0:
            self.position_size_multiplier *= 1.02
            logger.info(f"📈 WIN: PnL {pnl:.2f} → size multiplier: {self.position_size_multiplier:.3f}")
        elif pnl < 0:
            self.position_size_multiplier *= 0.995
            logger.info(f"📉 LOSS: PnL {pnl:.2f} → size multiplier: {self.position_size_multiplier:.3f}")
        state["pnl_applied"] = True
